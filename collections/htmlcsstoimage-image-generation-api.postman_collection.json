          "request": {
            "name": "Retrieve a rendered image.",
            "description": {
              "content": "Fetch a previously created image. Append a format extension (.png, .jpg, .webp, .pdf) to control the output format; PNG is the default. Query parameters allow on-the-fly resize and crop.",
