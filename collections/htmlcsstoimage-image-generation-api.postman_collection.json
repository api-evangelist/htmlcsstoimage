                  "disabled": false,
                  "key": "height",
                  "value": "<integer>",
                  "description": "Resize height in pixels."
                },
                {
                  "disabled": false,
                  "key": "dpi",
                  "value": "<integer>",
                  "description": "Output DPI."
                },
                {
                  "disabled": false,
                  "key": "aspect_ratio",
                  "value": "<string>",
                  "description": "Aspect ratio to apply, e.g. \"16:9\"."
                },
                {
                  "disabled": false,
                  "key": "crop_width",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "crop_height",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "dl",
                  "value": "<integer>",
                  "description": "Set to 1 to force a download response."
                }
              ],
              "variable": [
