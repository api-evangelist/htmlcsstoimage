          "id": "1f22b7cb-f636-42ad-b123-eba9b67b05fc",
          "name": "Generate a templated image from an HMAC-signed URL.",
          "request": {
            "name": "Generate a templated image from an HMAC-signed URL.",
            "description": {
              "content": "Render an image from a template using a signed token that encodes the template_values. The token is HMAC-signed with the API key so values cannot be modified by anyone without the key, allowing image generation from a simple GET request with no POST or stored URL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "image",
                ":template_id",
                "{{signed_token}}{{format}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "template_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/png"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "faed82d5-0d44-494d-a045-b6d62a52d56c",
